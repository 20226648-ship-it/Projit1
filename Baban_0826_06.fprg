<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Baban_0826_06"/>
        <attribute name="authors" value="baban_e"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-08-26 10:17:52 AM"/>
        <attribute name="created" value="YmFiYW5fZTtGMTEwV1MzOTsyMDI1LTA4LTI2OzA5OjQ3OjM0IEFNOzI0NzE="/>
        <attribute name="edited" value="YmFiYW5fZTtGMTEwV1MzOTsyMDI1LTA4LTI2OzEwOjE3OjUyIEFNOzE7MjU2OA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="chic, egg, tchic, tegg, schic" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter the number of chickens: &quot;" newline="True"/>
            <input variable="chic"/>
            <assign variable="schic" expression="chic*0.3"/>
            <assign variable="tchic" expression="chic-schic"/>
            <assign variable="egg" expression="tchic*3"/>
            <assign variable="tegg" expression="egg*5"/>
            <output expression="&quot;Farmer had &quot; &amp; chic &amp; &quot; chickens and sold 30% which is &quot; &amp; schic &amp; &quot; to the market and now left with &quot; &amp; tchic" newline="True"/>
            <output expression="&quot;If they lay 3 eggs each day, there would be &quot; &amp; egg &amp; &quot; eggs a day.&quot;" newline="True"/>
            <output expression="&quot;In 5 days the total eggs would be &quot; &amp; tegg &amp; &quot;.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
