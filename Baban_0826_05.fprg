    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="cel, fah" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter the temperature in celcius: &quot;" newline="True"/>
            <input variable="cel"/>
            <assign variable="fah" expression="(cel*(9/5))+32"/>
            <output expression="&quot;Therefore, &quot; &amp; cel &amp; &quot; degrees Celsius is equal to &quot; &amp; fah &amp; &quot; degrees Fahrenheit.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
