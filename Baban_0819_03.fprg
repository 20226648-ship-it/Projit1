    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="sale, profit, actual" type="Real" array="False" size=""/>
            <output expression="&quot;Enter the sale price: &quot;" newline="True"/>
            <input variable="sale"/>
            <output expression="&quot;Enter the purchase price: &quot;" newline="True"/>
            <input variable="actual"/>
            <assign variable="profit" expression="sale - actual"/>
            <output expression="&quot;Your total profit is &quot; &amp; profit &amp; &quot;.&quot;" newline="True"/>
            <output expression="&quot;Thank you for using this program.&quot;" newline="True"/>
        </body>
    </function>
