    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, area, volume" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter the edge&quot;" newline="True"/>
            <input variable="num1"/>
            <assign variable="area" expression="6*num1*num1"/>
            <assign variable="volume" expression="num1*num1*num1"/>
            <output expression="&quot;The surface area is &quot; &amp; area &amp; &quot; and the volume is &quot; &amp; volume &amp; &quot;.&quot;" newline="True"/>
        </body>
    </function>
